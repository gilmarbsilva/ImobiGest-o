# Supabase (pegue em Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sessão (OBRIGATÓRIO em produção): texto longo e aleatório, mínimo 32 caracteres
SESSION_SECRET_KEY=

# Administrador inicial (use uma senha forte e única)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Asaas
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Cadastro aberto de novos usuários (deixe sem valor ou false para manter desativado)
ALLOW_SIGNUP=false
